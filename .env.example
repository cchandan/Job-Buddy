# Copy to .env and fill in. Never commit .env.

# Postgres connection string (the Supabase *pooled* one in production).
# Leave blank to use a local SQLite file, for tests and local play only.
# DATABASE_URL=

# Signs the sign-in cookie. Any long random string; keep it the same between restarts.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional first admin. Set all three for a fresh deployment; never commit a real password.
# Password: 12–200 characters. Existing accounts/passwords are never overwritten.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# The AI used to read adverts and write tailored CVs. Optional: without it, tagging uses keywords
# and tailored CVs are unavailable.
GEMINI_API_KEY=
# GEMMA_MODEL=gemma-4-26b-a4b-it
# AI_DAILY_LIMIT=200

# --- Refreshing jobs (laptop only; see README) ---
# Optional free UK job APIs. Each switches on by itself when its keys are set.
# REED_API_KEY=            # https://www.reed.co.uk/developers  (gives real closing dates)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=          # https://developer.adzuna.com
# Tagging uses the first of these it finds: the `claude` command, the `codex` command, Ollama, then GEMINI_API_KEY.
# TAGGING_CLAUDE_MODEL=haiku
# TAGGING_CODEX_MODEL=gpt-6-luna   # install: brew install --cask codex, then run `codex` once and sign in with ChatGPT
# OLLAMA_MODEL=gemma3
# Publish to the live site over HTTPS instead of writing to its database directly. Set the SAME INGEST_TOKEN
# (20+ random characters) here and on Render. Leave both unset to use DATABASE_URL directly.
# INGEST_URL=https://your-app.onrender.com
# INGEST_TOKEN=
